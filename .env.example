# FLExTools MCP Configuration
# The MCP prefers installed packages (pip install) over repository paths.
# Leave paths commented out to use installed packages.
# Uncomment and set paths only if using repository clones instead of pip installs.

# OPTIONAL: Path to FlexLibs stable repository (only if not pip-installed)
# FLEXLIBS_PATH=../flexlibs

# OPTIONAL: Path to FlexLibs 2.0 repository (only if not pip-installed)
# FLEXLIBS2_PATH=../flexlibs2

# OPTIONAL: Path to LibLCM repository (for source reference only)
# LIBLCM_PATH=../liblcm

# OPTIONAL: Path to FieldWorks DLLs (usually auto-detected from installation)
# Options:
#   - FieldWorks installation: C:/Program Files/SIL/FieldWorks 9
#   - Debug build: D:/Github/Fieldworks/Output/Debug
#   - Release build: D:/Github/Fieldworks/Output/Release
# FIELDWORKS_DLL_PATH=C:/Program Files/SIL/FieldWorks 9

# OPTIONAL: Path to FLExTools repository (for examples only)
# FLEXTOOLS_PATH=../FLExTools

# OPTIONAL: Path to FieldWorks repository (for source reference only)
# FIELDWORKS_PATH=../Fieldworks

# OPTIONAL: Override the FieldWorks projects directory used by
# flextools_list_projects and the fuzzy project_name resolver.
# If unset, the MCP reads HKLM\Software\SIL\FieldWorks\9, value ProjectsDir,
# and falls back to %ProgramData%\SIL\FieldWorks\Projects.
# FW_PROJECTS_DIR=C:/ProgramData/SIL/FieldWorks/Projects
